# Copy to backend/.env and fill in. Never commit backend/.env.

# --- Required ---------------------------------------------------------------
# Your own Meta Model API key (https://dev.meta.ai). Without it the app runs,
# but scans report "Meta AI is not connected".
MODEL_API_KEY=
# Local MongoDB (e.g. `docker run -d -p 27017:27017 mongo:7`) or an Atlas URI.
MONGODB_URI=mongodb://localhost:27017/truemed

# --- Demo access ------------------------------------------------------------
# PIN for the hidden /admin page (Sentinel, DemoQuin reset). Pick any value.
ADMIN_PIN=change-me
# PIN a phone uses to sign in as a demo pharmacy or licensed chemist.
PHARMACIST_DEMO_PIN=2468

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4080
ALLOWED_ORIGINS=http://localhost:5173
# Spend guards: Meta calls stop gracefully at either cap (per day).
DAILY_CALL_CAP=3000
DAILY_SPEND_CAP_USD=15

# --- Optional ---------------------------------------------------------------
# ImageKit stores scan photos and videos. Leave blank to skip storage;
# scans still work, photos just aren't kept.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/truemed
# Simulated NAFDAC registry for the fictional DemoQuin brand (not NAFDAC).
NAFDAC_SANDBOX=on
# A real NAFDAC registry API, if one is ever opened. Leave blank.
NAFDAC_API_URL=
NAFDAC_API_KEY=
# One cached Greenbook lookup per unknown number. Off by default.
GREENBOOK_LOOKUP=off
